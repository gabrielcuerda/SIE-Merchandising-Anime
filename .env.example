# Supabase (requerido)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=TU_CLAVE_PUBLICA

# Supabase (solo panel admin)
# OBLIGATORIA para /admin. Service Role Key -> Supabase → Project Settings → API Keys.
# SOLO EN SERVIDOR: nunca la prefijes con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (opcional - necesario para checkout y webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App (opcional)
SITE_NAME=SIE Merchandising Anime
COMPANY_NAME=SIE Merchandising Anime

# Acceso admin a /admin: lista de correos separados por comas.
# Alternativa: marcar app_metadata.role = 'admin' en Supabase Auth.
ADMIN_EMAILS=admin@ejemplo.com

# Secreto compartido del endpoint POST /api/revalidate.
# Sin él el endpoint devuelve 503 y nadie puede revalidar la tienda a mano.
REVALIDATE_SECRET=

# Política de privacidad (/privacidad). Si se dejan vacías, la página
# enlaza al formulario de contacto en lugar de mostrar placeholders.
PRIVACY_EMAIL=privacidad@ejemplo.com
PRIVACY_CONTROLLER_ADDRESS=Calle Ejemplo 1, 28001 Madrid, España
PRIVACY_CONTROLLER_TAX_ID=B12345678
